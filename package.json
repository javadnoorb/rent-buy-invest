{
  "name": "rent-buy-invest",
  "private": true,
  "description": "Static app comparing buying a home, renting and investing.",
  "scripts": {
    "build": "python3 build.py --pwa",
    "build:artifact": "python3 build.py --out dist/artifact.html",
    "watch": "python3 build.py --pwa --watch",
    "serve": "python3 -m http.server 8000",
    "lint": "node tests/lint.js",
    "test": "node tests/lint.js && node tests/run.js",
    "smoke": "node tests/smoke.js",
    "smoke:offline": "STUB_PLOTLY=1 node tests/smoke.js",
    "test:ui": "node tests/ui.js",
    "check": "npm run build && npm test && npm run smoke:offline && npm run test:ui",
    "typecheck": "npx -y -p typescript@5.6.3 tsc -p .",
    "check:all": "scripts/check.sh",
    "check:fast": "scripts/check.sh --fast"
  },
  "devDependencies": {
    "playwright": "1.47.2"
  }
}
